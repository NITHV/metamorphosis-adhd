# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres (Vercel dashboard → Storage → Neon). Use the pooled connection string.
DATABASE_URL=

# Random secret: run  npx @better-auth/cli secret  (or any 32+ random characters)
BETTER_AUTH_SECRET=
# The app's URL. Local: http://localhost:3000   Production: https://<your-app>.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional locally; Google Cloud Console → Credentials → OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Magic-link email via Gmail (postponed; not used yet)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Vercel Blob (private store for voice notes). Added by: vercel blob create-store
BLOB_READ_WRITE_TOKEN=
